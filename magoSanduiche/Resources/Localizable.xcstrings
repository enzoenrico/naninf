    "nan_onboarding_testimonial_l_persona": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fantasy fan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fã de fantasia"
          }
        }
      }
    },
    "nan_onboarding_testimonial_l_quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is exactly the kind of game I always wanted as a kid. Thanks so much for letting us make our own stories!\nIn case anyone is wondering, this is a game where you are given story prompts and events, and you write your response in a chat box. This response can be anything. ANYTHING. So if you are looking for a story with an alchemical creation of magic, a bonding moment with some ghouls, and the Fabled Hazard Suit of Durin, this is the perfect game. \nThanks so much for making this!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os momentos de d20 fizeram escolhas miúdas parecerem dramáticas."
          }
        }
      }
    },
    "nan_onboarding_testimonial_m_persona": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Casual adventurer"
          }
        },
        "pt-BR": {
