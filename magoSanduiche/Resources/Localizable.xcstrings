    "nan_onboarding_testimonial_r_quote": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It feels like texting a Dungeon Master who says yes to my weird plans."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece mandar mensagem para um Mestre que diz sim aos meus planos malucos."
          }
        }
      }
    },
    "nan_onboarding_welcome_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No character sheet. No group chat. Just type what your mage does, roll when fate asks, and watch the dungeon answer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ficha de personagem. Sem grupo no chat. É só digitar o que seu mago faz, rolar quando o destino pedir e ver a masmorra responder."
          }
        }
      }
    },
    "nan_onboarding_welcome_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pocket dungeon is waiting."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua masmorra de bolso está esperando."
          }
        }
      }
    },
