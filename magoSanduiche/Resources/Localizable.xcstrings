            "value": "Aventureiro casual"
          }
        }
      }
    },
    "nan_onboarding_testimonial_m_quote": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I got a full dungeon scene during a coffee break. No rules homework needed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tive uma cena inteira de masmorra no intervalo do café. Sem lição de regras."
