// Paste your RevenueCat *public* Apple SDK key here (appl_...).
// This file is gitignored as Secrets.xcconfig when copied to:
//   magoSanduiche/Config/Secrets.xcconfig
//
// Then set the magoSanduiche target's Debug/Release configurations to
// `#include? "Config/Secrets.xcconfig"` via an xcconfig base, or set
// REVENUECAT_API_KEY in Xcode Build Settings (same pattern as SUPABASE_*).

REVENUECAT_API_KEY = REPLACE_ME
